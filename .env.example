# Copy this file to ".env" and edit if needed. Every value has a default,
# so the project also runs without a .env file. There are NO API keys here.

# ---------- Ollama (local LLM) ----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=250
# Speed: keep the model in RAM between questions and limit the context window
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
# Faster model options: llama3.2:1b (fastest) | gemma3:1b | qwen2.5:1.5b | llama3.2:3b (better quality, slower)

# ---------- Retrieval / RAG ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
RETRIEVAL_MIN_SCORE=0.25

# ---------- NLI verification ----------
# Set ENABLE_NLI=false on a low-memory machine to use the lexical fallback.
ENABLE_NLI=true
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_ENTAILMENT_THRESHOLD=0.60
NLI_CONTRADICTION_THRESHOLD=0.50

# ---------- Claim extraction ----------
MAX_CLAIMS=8
MIN_CLAIM_LENGTH=12

# ---------- Hallucination Risk Score weights ----------
W_CONTRADICTION=0.40
W_UNSUPPORTED=0.30
W_NLI_UNCERTAINTY=0.20
W_MODEL_UNCERTAINTY=0.10
LOW_RISK_MAX=30
MEDIUM_RISK_MAX=60

# ---------- Self-correction loop ----------
RISK_THRESHOLD=30
MAX_ITERATIONS=3

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- Accounts (login) ---
# Long random text, e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# AUTH_REQUIRED=true

# --- Photos (optional): a vision model pulled in Ollama, e.g. `ollama pull llava` ---
# OLLAMA_VISION_MODEL=llava
# MAX_ATTACHMENTS=5
# MAX_ATTACHMENT_MB=8
