# Copy this file to ".env" and edit if needed. Every value has a default,
# so the project also runs without a .env file. There are NO API keys here.

# ---------- Ollama (local LLM) ----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=400

# ---------- Retrieval / RAG ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
RETRIEVAL_MIN_SCORE=0.25

# ---------- NLI verification ----------
# Set ENABLE_NLI=false on a low-memory machine to use the lexical fallback.
ENABLE_NLI=true
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_ENTAILMENT_THRESHOLD=0.60
NLI_CONTRADICTION_THRESHOLD=0.50

# ---------- Claim extraction ----------
MAX_CLAIMS=8
MIN_CLAIM_LENGTH=12

# ---------- Hallucination Risk Score weights ----------
W_CONTRADICTION=0.40
W_UNSUPPORTED=0.30
W_NLI_UNCERTAINTY=0.20
W_MODEL_UNCERTAINTY=0.10
LOW_RISK_MAX=30
MEDIUM_RISK_MAX=60

# ---------- Self-correction loop ----------
RISK_THRESHOLD=30
MAX_ITERATIONS=3

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
